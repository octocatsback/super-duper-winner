# Compiled source #
###################
*.com
*.class
*.dll
*.exe
*.o
*.so

# Packages #
############
# it's better to unpack these files and commit the raw source
# git has its own built in compression methods
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# Logs and databases #
######################
*.log
*.sql
*.sqlite

# OS generated files #
######################
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Astro / Node build artifacts #
###############################
site/node_modules/
site/dist/
site/.astro/
site/.vercel/
site/.netlify/
site/.env
site/.env.*
.env
.env.*
!.env.example
!.env.*.example

# Credentials and keys — never commit these
*.pem
*.p12
*.pfx
id_rsa
id_ecdsa
id_ed25519
*.id_rsa
secrets.local.*
credentials.json
auth.json
